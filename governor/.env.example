PORT=4001

# Where SigNoz's OTel Collector is listening — the governor's OWN spans
# (its self-tracing) go here too, same as the agent.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# SigNoz's query API (self-hosted) — used to pull real span data back out
# for each session, and to create alert rules on trip.
SIGNOZ_API_URL=http://localhost:8080/api
# SigNoz's UI base URL — used only to build human-clickable deep links
# into real traces (see signozClient.js's traceUrl()), not for API calls.
SIGNOZ_UI_URL=http://localhost:8080
# Get this from SigNoz UI -> Settings -> Service Accounts -> Keys.
# NOTE: human notification is NOT sent from this service directly — it
# goes through a Notification Channel + Routing Policy configured ONCE in
# the SigNoz UI (see README Step 0). Alert rules created here carry a
# `source: governor` label; the routing policy matches on that label and
# SigNoz's own Alertmanager sends the actual notification.
SIGNOZ_API_KEY=

# Base URL of the running agent, so the governor can send /control/pause
AGENT_CONTROL_URL=http://localhost:3500

# How often (ms) the governor polls SigNoz for each active session's spans.
# Needs to be meaningfully shorter than the agent's loop/fail scenario
# duration (see agent/src/agent.js MAX_STUCK_ITERATIONS *
# STUCK_ITERATION_DELAY_MS) or the governor will only ever catch a stuck
# session after it's already finished on its own, not mid-flight.
POLL_INTERVAL_MS=2000

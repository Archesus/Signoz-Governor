GEMINI_API_KEY=your-gemini-api-key-here

# Where SigNoz's OTel Collector is listening (default self-host port)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Port this agent's own control API listens on (governor calls back here)
AGENT_CONTROL_PORT=3500

# Where the governor lives, so this agent can register itself
GOVERNOR_URL=http://localhost:4001
